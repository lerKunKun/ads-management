# ===== App =====
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173

# ===== PostgreSQL =====
# 应用/Worker 运行时用 ads_app(非 SUPERUSER, 受 RLS 约束)
DATABASE_URL=postgres://ads_app:ads_app@localhost:5432/ads
# 迁移/seed 用 ads(SUPERUSER, 可绕 RLS)
DATABASE_ADMIN_URL=postgres://ads:ads@localhost:5432/ads

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== RabbitMQ =====
RABBITMQ_URL=amqp://ads:ads@localhost:5672

# ===== JWT =====
JWT_SECRET=replace-me-with-strong-random-string
JWT_EXPIRES_IN=12h

# ===== Token 加密 (AES-256-GCM, 32 字节, base64 编码) =====
# 生成: $bytes = New-Object byte[] 32; $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes)
TOKEN_ENC_KEY=

# ===== CRM (全局单一凭证，不入库) =====
CRM_BASE_URL=https://adtool-api.gimc-hk.com
CRM_CID=
CRM_ACCESS_TOKEN=

# ===== Meta Graph API =====
META_API_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com
META_ASYNC_COPY_TIMEOUT_MS=1800000

# ===== OAuth 回调 (前端页面) =====
FB_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/fb/callback

# ===== 广告对象查询/同步 =====
# 线上强实时测试建议 0；常规环境可设 30000 减少重复查询 Meta。
AD_OBJECT_CACHE_TTL_MS=30000
AD_OBJECT_SYNC_ENABLED=0
AD_OBJECT_SYNC_INTERVAL_MS=300000
AD_OBJECT_SYNC_BATCH_SIZE=2
AD_OBJECT_SYNC_DEPTH=campaign
AD_OBJECT_SYNC_MAX_CAMPAIGNS=20
AD_OBJECT_SYNC_MAX_ADSETS=50
AD_OBJECT_SYNC_STALE_MS=900000

# ===== Mock 开关 =====
# 线上测试不要配置 META_FAKE / FAKE_* / MOCK_*。
# META_FAKE=1

# ===== Notifier (MVP 仅 console; 飞书后期接) =====
NOTIFIER_DRIVER=console
# FEISHU_WEBHOOK_URL=
